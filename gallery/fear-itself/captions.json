[
  {
    "start": 0.12,
    "end": 1.65,
    "text": "首先，",
    "original": "So, first of all,"
  },
  {
    "start": 2.25,
    "end": 5.6,
    "text": "请让我申明我的坚定信念：",
    "original": "let me assert my firm belief that"
  },
  {
    "start": 5.7,
    "end": 8.5,
    "text": "我们唯一需要恐惧的，",
    "original": "the only thing we have to fear"
  },
  {
    "start": 8.5,
    "end": 12.2,
    "text": "就是恐惧本身——",
    "original": "is fear itself—"
  },
  {
    "start": 12.5,
    "end": 13.22,
    "text": "那种无名的、",
    "original": "nameless,"
  },
  {
    "start": 13.3,
    "end": 14.42,
    "text": "非理性的、",
    "original": "unreasoning,"
  },
  {
    "start": 14.55,
    "end": 15.85,
    "text": "毫无根据的恐惧，",
    "original": "unjustified terror"
  },
  {
    "start": 15.85,
    "end": 18.8,
    "text": "它使必要的努力陷入瘫痪，",
    "original": "which paralyzes needed efforts"
  },
  {
    "start": 18.8,
    "end": 20.62,
    "text": "使我们无法将退却",
    "original": "to convert retreat"
  },
  {
    "start": 20.62,
    "end": 22.65,
    "text": "转化为前进。",
    "original": "into advance."
  }
]